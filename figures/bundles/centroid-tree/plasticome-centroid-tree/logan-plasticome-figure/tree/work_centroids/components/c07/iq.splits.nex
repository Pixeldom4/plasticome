	100	 2,
	100	 3,
	100	 4,
	9	 3 4,
	29	 1 5,
	100	 5,
	100	 1,
	18	 2 4,
	41	 2 3,
	66	 1 4,
	30	 3 5,
	8	 2 5,
	1	 1 3,
	0	 1 2,
;
END; [Splits]

